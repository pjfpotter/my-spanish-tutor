# Copy to .env and fill in from the Neon console (Connect button).
# Pooled connection, used by the app:
DATABASE_URL=
# Direct connection (hostname without -pooler), used by migrations:
DATABASE_URL_UNPOOLED=

# ElevenLabs text to speech (server side only, via the cost router):
ELEVENLABS_API_KEY=
# ElevenLabs voice ID for the Tele persona:
ELEVENLABS_VOICE_TELE=
# Optional. A direction put at the start of every sentence, taken out of the captions. Needs ELEVENLABS_MODEL=eleven_v3.
ELEVENLABS_TAG=

# OpenAI (server side only, via the cost router):
OPENAI_API_KEY=
